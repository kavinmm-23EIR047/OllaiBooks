{
  "name": "ollaibooks-desktop",
  "version": "1.0.0",
  "description": "ollaiBooks Universal Offline POS - Standalone Desktop App for Windows, macOS & Linux",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.1"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ollaibooks.pos.desktop",
    "productName": "ollaiBooks Universal POS",
    "copyright": "Copyright © 2026 ollaiBooks AI",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": ["nsis", "portable"],
      "icon": "../web/public/billpilot-icon-512.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.business",
      "icon": "../web/public/billpilot-icon-512.png"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
