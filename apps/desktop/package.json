{
  "name": "ollaibooks-desktop",
  "version": "1.1.0",
  "description": "ollaiBooks Universal Offline POS - Standalone Desktop App for Windows, macOS & Linux",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:win": "node ../../scripts/prepare-desktop-app.js && electron-builder --win --x64",
    "build:mac": "node ../../scripts/prepare-desktop-app.js && electron-builder --mac",
    "build:linux": "node ../../scripts/prepare-desktop-app.js && electron-builder --linux"
  },
  "devDependencies": {
    "electron": "30.5.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.ollaibooks.pos.desktop",
    "productName": "ollaiBooks Universal POS",
    "copyright": "Copyright © 2026 ollaiBooks AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "pos-server/**",
      "!pos-server/**/*.map",
      "!pos-server/**/README*",
      "!pos-server/**/*.md",
      "!pos-server/**/*.d.ts"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../web/public/billpilot-icon-512.png",
      "signAndEditExecutable": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.business",
      "icon": "../web/public/billpilot-icon-512.png"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Office"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "differentialPackage": false
    },
    "compression": "maximum",
    "asar": true,
    "electronLanguages": [
      "en-US"
    ]
  }
}
