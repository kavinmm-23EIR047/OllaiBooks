# ========================================================
# BillPilot AI - High-Scale Multi-Tenant Environment Configuration Template
# Designed for 1,000,000+ Concurrent Customers & Invoices
# ========================================================

# PostgreSQL 16 Database with High-Throughput Connection Pooling
DATABASE_URL="postgresql://postgres:1234@127.0.0.1:5432/BIlldesk?schema=public&connection_limit=50&pool_timeout=30"

# Redis Cache & Background Task Queue (BullMQ)
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
DISABLE_REDIS="false"

# Server Security & Admin Bridge Keys
AK_ADMIN_SERVICE_KEY="replace-with-a-random-secret-at-least-32-bytes"
INTEGRATION_ENCRYPTION_KEY="replace-with-64-hex-characters"

# API Server Configuration
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"
APP_BASE_URL="http://localhost:4000"
WEB_APP_URL="http://localhost:3000"

# JWT Authentication
JWT_SECRET="replace-with-a-random-secret-at-least-32-bytes"
JWT_EXPIRATION="7d"

# Initial account bootstrap (set these in the ignored local apps/api/.env)
PLATFORM_ADMIN_EMAIL="admin@billdesk.local"
PLATFORM_ADMIN_PASSWORD="replace-with-a-unique-password-of-16-or-more-characters"
INITIAL_CUSTOMER_BUSINESS_NAME="The Chocolate Mine"
INITIAL_CUSTOMER_EMAIL="customer@example.com"
INITIAL_CUSTOMER_PASSWORD="replace-with-the-customer-password"

# ========================================================
# NVIDIA NIM AI Configuration (NVIDIA Inference Microservices)
# Powers backend financial Q&A, invoice OCR parsing and WhatsApp copy; not live call audio
# ========================================================
# Obtain your key at: https://build.nvidia.com/
NVIDIA_NIM_API_KEY="replace-with-your-own-key"
NVIDIA_NIM_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_NIM_MODEL="meta/llama-3.3-70b-instruct"
NVIDIA_CHAT_MODEL="meta/llama-3.3-70b-instruct"
NVIDIA_EMBEDDING_MODEL="nvidia/nemotron-3.5-embed-1b"
NVIDIA_NIM_TIMEOUT_MS=25000

# Meta WhatsApp Cloud API (Optional mock in development)
WHATSAPP_API_URL="https://graph.facebook.com/v26.0"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_WABA_ID=""
WHATSAPP_ACCESS_TOKEN=""

# AI Voice Telephony Agent (LiveKit worker; no secrets committed)
VOICE_AGENT_WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
VOICE_WORKER_URL="http://127.0.0.1:8091"
VOICE_WORKER_API_KEY="replace-with-at-least-32-random-characters"
# Match VOICE_WORKER_API_KEY to WORKER_API_KEY in apps/voice-worker/.env.
# Match VOICE_AGENT_WEBHOOK_SECRET to the same variable in apps/voice-worker/.env.
VOICE_TRANSCRIPT_RETENTION_DAYS=90
VOICE_PAYMENT_TEMPLATE_NAME=""
# HTTPS merchant portal must validate tenant/invoice access and include both placeholders.
PAYMENT_LINK_URL_TEMPLATE=""

# Email Provider (Resend / Brevo / AWS SES)
EMAIL_PROVIDER="MOCK"
RESEND_API_KEY=""

# S3 / Object Storage (Private Bucket for PDF Invoices & Reports)
S3_BUCKET_NAME="billpilot-documents"
S3_REGION="ap-south-1"
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Admin console (/admin) login (password: 8+ characters, letters + numbers)
ADMIN_ID=ollaibooks-admin
ADMIN_PASSWORD=change-me-8chars
