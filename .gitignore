# Keep local environment secrets out of source control.
**/.env
**/.env.*
!**/.env.example

# Dependencies & Build Outputs
**/node_modules/
**/.next/
**/dist/
apps/desktop/dist/
apps/desktop/pos-server/
android/
ios/

# Python virtual environments and generated files
**/.venv/
**/venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/htmlcov/

# Framework and compiler output
**/out/
**/coverage/
**/*.tsbuildinfo

# Local logs and editor / OS files
*.log
.DS_Store
Thumbs.db
.idea/
.vscode/
